---
import Layout from '../layouts/Layout.astro'
import { projects, type Locale } from '../data/projects'

// Language is intentionally selected in one place so an /en version can be
// added later without changing the project card structure.
const locale: Locale = 'cn'
---
<Layout title="Public Projects & Research · your-name">
  <section class="projects-page">
    <h1>Public Projects &amp; Research</h1>
    {projects.length === 0 ? (
      <div class="empty-state"><span class="prompt">$</span> find ./projects -maxdepth 1<br /><span class="comment"># something interesting is loading...</span><span class="cursor">█</span></div>
    ) : (
      <div class="project-list">
        {projects.map((project) => {
          const content = project[locale] ?? project.en ?? project.cn
          return <article class="project-card" id={project.slug}>
            <a class="project-image" href={project.link} target="_blank" rel="noreferrer"><img src={project.image} alt="Galaxy project preview" /></a>
            <div class="project-body">
              <h2><a href={project.link} target="_blank" rel="noreferrer">{content.title}</a></h2>
              {content.subtitle && <p class="subtitle">{content.subtitle}</p>}
              {content.description ? <div class="description">{content.description.split('\n\n').map((paragraph) => <p>{paragraph}</p>)}</div> : <ul>{content.bullets?.map((bullet) => <li>{bullet}</li>)}</ul>}
              <a class="project-link" href={project.link} target="_blank" rel="noreferrer">View project ↗</a>
            </div>
          </article>
        })}
      </div>
    )}
  </section>
</Layout>
<style>
  .section-label { color: #3f7653; font-size: 13px; margin: 0 0 14px; } h1 { color: #075985; font-size: 32px; font-weight: 500; margin: 0 0 34px; } .project-list { display: grid; gap: 34px; } .project-card { display: grid; grid-template-columns: minmax(250px, 38%) 1fr; gap: 28px; padding-bottom: 34px; border-bottom: 1px solid #b7c9b9; } .project-image { align-self: start; overflow: hidden; border: 1px solid #b7c9b9; background: #eaf0ea; } .project-image img { display: block; width: 100%; aspect-ratio: 16 / 10; object-fit: cover; transition: transform .2s ease; } .project-image:hover img { transform: scale(1.02); } .project-body h2 { margin: 0 0 10px; font-size: clamp(19px, 2.3vw, 27px); line-height: 1.35; font-weight: 600; } .project-body h2 a { color: #26352b; text-decoration: none; } .project-body h2 a:hover { color: #075985; } .subtitle { margin: 0 0 18px; color: #3f7653; font-size: 14px; line-height: 1.6; } .description { margin: 0 0 20px; color: #26352b; font-size: 14px; line-height: 1.8; } .description p { margin: 0 0 14px; } .project-body ul { margin: 0 0 20px; padding-left: 20px; list-style: disc; color: #26352b; font-size: 14px; line-height: 1.7; } .project-body li { margin: 5px 0; } .project-link { color: #075985; font-size: 13px; text-decoration: none; } .project-link:hover { text-decoration: underline; } .empty-state { padding: 24px; border: 1px solid #b7c9b9; background: #f4f8f4; color: #496451; line-height: 1.8; font-size: 14px; } .prompt { color: #398655; } .comment { color: #4d6653; } .cursor { color: #4d9b5d; margin-left: 5px; animation: blink 1.1s steps(2, start) infinite; } @keyframes blink { 50% { opacity: 0; } } @media (max-width: 700px) { .project-card { grid-template-columns: 1fr; gap: 18px; } }
</style>
