---
import { getCollection } from 'astro:content'
import Layout from '../layouts/Layout.astro'
import { template } from '../settings'

const posts = (await getCollection('blogs')).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
---
<Layout title="blogs · spdc-elm">
  <section class="blog-page">
    <h1>Blogs</h1>
    {posts.length === 0 ? (
      <div class="empty-state"><span class="prompt">$</span> ls -la<br /><span class="muted">total 0</span><br /><br /><span class="comment"># notes will appear here soon</span><span class="cursor">█</span></div>
    ) : (
      <div class="entries">
        {posts.map((post) => <article><time>{post.data.date.toISOString().slice(0, 10)}</time><h2><a href={`${template.base}/blogs/${post.id.toLowerCase()}`}>{post.data.title}</a></h2>{post.data.excerpt && <p>{post.data.excerpt}</p>}</article>)}
      </div>
    )}
  </section>
</Layout>
<style>
  .section-label { color: #3f7653; font-size: 13px; margin: 0 0 14px; } h1 { color: #264b2e; font-size: 32px; font-weight: 500; margin: 0 0 34px; } .empty-state { width: min(650px, 100%); padding: 24px; border: 1px solid #c7d8c9; background: #f4f8f4; color: #496451; line-height: 1.8; font-size: 14px; } .prompt { color: #398655; } .muted, .comment { color: #4d6653; } .cursor { color: #4d9b5d; margin-left: 5px; animation: blink 1.1s steps(2, start) infinite; } @keyframes blink { 50% { opacity: 0; } }
  .entries { display: grid; gap: 26px; max-width: 860px; } article { border-bottom: 1px solid #c7d8c9; padding-bottom: 22px; } time { color: #3f7653; font-size: 12px; } h2 { margin: 8px 0; font-size: 18px; font-weight: 500; } h2 a { color: #264b2e; text-decoration: none; } h2 a:hover { color: #1976a8; } article p { margin: 0; color: #4d6653; font-size: 13px; }
</style>
